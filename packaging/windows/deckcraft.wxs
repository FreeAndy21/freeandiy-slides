<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeANDIY Slides MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build deckcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.freeandiy-slides` owned by
  FreeANDIY Slides, and FreeANDIY Slides offered under "Open with" for .pptx/.potx/.ppsx (without taking over
  the user's default app for them).

  UpgradeCode is fixed for FreeANDIY Slides forever (playbook §6); never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FreeANDIY Slides"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="5BB35656-DD4B-4682-8143-CD3411812737"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FreeANDIY Slides presentations and slide shows" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FreeANDIY Slides is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeckcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeckcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://freeandiy.freeandy.agency/slides" />
    <Property Id="ARPURLUPDATEINFO" Value="https://freeandiy.freeandy.agency/slides" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FreeAndy21/freeandiy-slides/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FreeANDIY Slides" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FreeANDIY Slides" Level="1">
      <ComponentGroupRef Id="DeckcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeckcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DeckcraftApp" Guid="81071293-EEFE-43CE-8992-2C96A0C74B1F">
        <File Id="DeckcraftExe" Source="$(var.BinDir)\freeandiy-slides.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FreeANDIY Slides"
              Description="FreeANDIY Slides presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DeckcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .freeandiy-slides: FreeANDIY Slides's own format. -->
        <ProgId Id="FreeANDIY Slides.Presentation" Description="FreeANDIY Slides Presentation" Icon="DeckcraftExe" IconIndex="0">
          <Extension Id="freeandiy-slides" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="DeckcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe" Name="FriendlyAppName" Value="FreeANDIY Slides" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe\SupportedTypes" Name=".freeandiy-slides" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-slides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="FreeANDIY Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="FreeANDIY Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="FreeANDIY Slides.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\freeandiy-slides.exe" Value="[#DeckcraftExe]" Type="string" />
      </Component>

      <Component Id="DeckcraftCli">
        <File Id="DeckcraftCliExe" Source="$(var.BinDir)\freeandiy-slides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
